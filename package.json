{
  "name": "valoutils",
  "version": "1.0.9",
  "private": true,
  "description": "A app that provides extra tools for Valorant",
  "author": "windowsedd",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite",
    "build:vite": "tsc && vite build",
    "tauri": "tauri",
    "build": "tsc && vite build && tauri build",
    "release": "bun run build",
    "version": "bun scripts/release-version.ts",
    "version:check": "bun scripts/release-version.ts --check",
    "banner": "bun scripts/generate-banner.ts",
    "lint": "oxlint src --fix",
    "fmt": "oxfmt \"**/*.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@tauri-apps/api": "^2.11.1",
    "axios": "^1.19.0",
    "i18next": "^26.3.6",
    "imurmurhash": "0.1.4",
    "minimatch": "^10.2.6",
    "moment": "^2.30.1",
    "oxfmt": "^0.66.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-icons": "^5.7.0",
    "swagger-ui-react": "^5.32.12",
    "swr": "^2.5.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^6.0.5",
    "oxlint": "1.76.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "takumi-js": "^2.13.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1"
  },
  "overrides": {
    "js-yaml": "^4.3.1"
  }
}
