{
	"name": "@windowsedd/valo-replay-parser",
	"version": "0.1.0",
	"description": "TypeScript port of the VALORANT replay parser (Unreal Engine network-replication decompressor). Research/PoC — ported from michel-giehl/ValorantReplayParserPlayground.",
	"type": "module",
	"author": {
		"name": "windowsedd"
	},
	"private": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"keywords": [
		"valorant",
		"replay",
		"unreal",
		"parser"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^22.20.0",
		"typescript": "^6.0.3",
		"vitest": "^2.1.0"
	},
	"dependencies": {
		"@windowsedd/valo-replay-parser": "^0.1.0",
		"@windowsedd/valorant-api": "^1.0.0"
	}
}
